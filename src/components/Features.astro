---
import { formatUpdatedDate } from "../lib/updated-date";

interface Props {
  lang?: "pt" | "es";
}

const { lang = "pt" } = Astro.props;
const isEs = lang === "es";

// The page is prerendered, so this is only the build-time fallback.
// The script below recalculates it from the visitor's clock.
const locale = isEs ? "es-ES" : "pt-BR";
const updatedDate = formatUpdatedDate(locale);

const t = isEs
  ? {
      updated: "Actualizado:",
      salutation: "Querido dueño de negocio,",

      hook: "Ya estuvimos en tus zapatos.",
      line1: "Despertando antes del sol.",
      line2: "Herramientas en la camioneta. Café en la mano.",
      line3: "Construyendo algo real para tu familia y tu futuro.",

      question: "¿Y hacer crecer un negocio en este país?",
      hard: "Es difícil. **Difícil, de ver*as.**",

      pain1: "Vives pensando de dónde va a salir el próximo cliente.",
      pain2:
        "Y no cualquier cliente. Uno que valore tu trabajo y no te subestime por tu acento o tu nombre.",

      stressed:
        "Estresado. Durmiendo como bebé con cólicos y gallo en el mismo cuarto.",

      everyoneHeader: "Y todo el mundo tiene una opinión:",
      voice1: '"Necesitas un sitio web, mano."',
      voice2: '"Métete al TikTok, ¡es marketing gratis!"',
      voice3: '"¡Reseñas en Google, anuncios en Facebook, un logo profesional!"',

      selfIntro: "Y entonces llega la duda:",
      q1: "¿Postear en Instagram todos los días?",
      q2: "¿Correr anuncios en Google?",
      q3: "¿Montar un programa de referidos?",
      q4: "¿Gastar $3k en un logo?",

      scream: "*por el amor de Dios, que alguien me ayude*",

      notAlone:
        "Mira, casi todo dueño de un negocio de servicios pasa por esto al empezar.",
      confused:
        'Es una confusión mezclada con "tengo que hacerlo todo solo" y sazonada con "no sé en quién confiar".',

      syndrome:
        "Le llamamos a esto **el síndrome del Inmigrante**.",

      describe1:
        "Abriste una LLC y crees que eres empresario. En realidad, te convertiste en el empleado peor pagado de tu propia empresa.",
      describe2:
        "Y crees que cobrar 40% menos para llenar la agenda va a resolverlo todo.",

      bridge: "Pero la verdad es que **existe una solución**.",

      heroIntro:
        "Quizás no lo sepas, pero a los ojos de un americano eres un **súper héroe**.",
      heroParen: "(La persona correcta para resolver su problema.)",

      traits: "Tu habilidad. Tu confiabilidad. Tu palabra.",
      traitsGold: "**Eso es oro.**",

      promise:
        "Solo te falta el sistema correcto para convertir eso en clientes constantes, reseñas de 5 estrellas y referidos. Sin caos.",

      closing: "Todo comienza eligiendo tu camino a continuación.",
    }
  : {
      updated: "Atualizado:",
      salutation: "Querido empresário,",

      hook: "Já estive na sua pele.",
      line1: "Acordando antes do sol.",
      line2: "Ferramentas no carro. Café na mão.",
      line3: "Construindo algo real pra sua família e pro seu futuro.",

      question: "E fazer um negócio crescer nesse país?",
      hard: "É difícil. **Difícil, pra c*ralho.**",

      pain1: "Você vive pensando de onde vai vir o próximo cliente.",
      pain2:
        "E não qualquer cliente. Um que valorize seu trabalho e não te subestime pelo sotaque ou pelo nome.",

      stressed:
        "Estressado. Dormindo igual bebê com cólica e galo no mesmo quarto.",

      everyoneHeader: "E todo mundo tem uma opinião:",
      voice1: '"Você precisa de um site, mano."',
      voice2: '"Entra no TikTok, é marketing de graça!"',
      voice3: '"Avaliação no Google, anúncio no Facebook, um logo profissional!"',

      selfIntro: "E aí vem a dúvida:",
      q1: "Postar no Instagram todo dia?",
      q2: "Rodar anúncio no Google?",
      q3: "Montar um programa de indicações?",
      q4: "Gastar $3k num logo?",

      scream: "*pelo amor de Deus, alguém me ajuda*",

      notAlone:
        "Olha, quase todo dono de negócio de serviços passa por isso no começo.",
      confused:
        'É uma confusão misturada com "tenho que fazer tudo sozinho" e temperada com "não sei em quem confiar".',

      syndrome:
        "A gente chama isso de **síndrome do Imigrante**.",

      describe1:
        "Você abriu uma LLC e acha que virou empresário. Na real, virou o funcionário mais mal pago da própria empresa.",
      describe2:
        "E acredita que cobrar 40% mais barato pra encher a agenda vai resolver tudo.",

      bridge: "Mas a verdade é que **existe uma solução**.",

      heroIntro:
        "Talvez você não saiba, mas aos olhos de um americano você é um **super herói**.",
      heroParen: "(A pessoa certa pra resolver o problema dele.)",

      traits: "Sua habilidade. Sua confiabilidade. Sua palavra.",
      traitsGold: "**Isso é ouro.**",

      promise:
        "Só falta o sistema certo pra transformar isso em clientes constantes, avaliações 5 estrelas e indicações. Sem caos.",

      closing: "Tudo começa escolhendo o seu caminho abaixo.",
    };

// Inline markdown-ish renderer: **bold** and *italic* → HTML.
// Kept tiny on purpose; only used on copy we control above.
function renderInline(s: string): string {
  return s
    .replace(/\\\*/g, "&#42;")
    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
    .replace(/\*(.+?)\*/g, "<em>$1</em>")
    .replace(/&#42;/g, "*");
}
---

<section class="py-24 md:py-32 bg-[#f4f4f5] text-zinc-900 border-t-8 border-primary">
  <div class="container mx-auto px-4">
    <article class="mx-auto max-w-2xl font-sans text-zinc-800">
      <p class="mb-10 text-sm font-medium uppercase tracking-widest text-zinc-500">
        {t.updated} <time data-updated-date data-locale={locale}>{updatedDate}</time>
      </p>

      <p class="mb-6 text-[1.1rem] md:text-[1.5rem] font-medium text-zinc-900">
        {t.salutation}
      </p>

      <div class="space-y-6 text-[1.1rem] md:text-[1.5rem] leading-relaxed">
        <p>{t.hook}</p>

        <p>{t.line1}</p>
        <p>{t.line2}</p>
        <p>{t.line3}</p>

        <p>{t.question}</p>
        <p set:html={renderInline(t.hard)} />

        <p>{t.pain1}</p>
        <p>{t.pain2}</p>

        <p>{t.stressed}</p>

        <p>{t.everyoneHeader}</p>

        <p>{t.voice1}</p>
        <p>{t.voice2}</p>
        <p>{t.voice3}</p>

        <p>{t.selfIntro}</p>

        <p>{t.q1}</p>
        <p>{t.q2}</p>
        <p>{t.q3}</p>
        <p>{t.q4}</p>

        <p set:html={renderInline(t.scream)} />

        <p>{t.notAlone}</p>
        <p>{t.confused}</p>

        <p set:html={renderInline(t.syndrome)} />

        <p>{t.describe1}</p>
        <p>{t.describe2}</p>

        <p set:html={renderInline(t.bridge)} />

        <p set:html={renderInline(t.heroIntro)} />
        <p class="text-zinc-600"><em>{t.heroParen}</em></p>

        <p>{t.traits}</p>
        <p set:html={renderInline(t.traitsGold)} />

        <p>{t.promise}</p>

        <p>{t.closing}</p>
      </div>
    </article>
  </div>
</section>

<script>
  import { formatUpdatedDate } from "../lib/updated-date";

  document.querySelectorAll<HTMLElement>("[data-updated-date]").forEach((el) => {
    el.textContent = formatUpdatedDate(el.dataset.locale || "pt-BR");
  });
</script>
